# ==========================================
# Frontend build
# ==========================================
FROM node:22-bookworm-slim AS frontend

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build


# ==========================================
# Laravel production
# ==========================================
FROM php:8.4-fpm-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        gettext-base \
        libpq-dev \
        libzip-dev \
        nginx \
        supervisor \
        unzip \
    && docker-php-ext-install \
        pdo_pgsql \
        zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

# Install production dependencies.
# Do not run migrations or generate APP_KEY during image build.
RUN rm -f bootstrap/cache/*.php \
    && composer install \
        --no-dev \
        --no-interaction \
        --prefer-dist \
        --optimize-autoloader \
        --no-scripts \
    && php artisan package:discover --ansi \
    && mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache
# Copy the Vite production assets.
COPY --from=frontend /app/public/build ./public/build

# Nginx configuration and process management.
COPY docker/render/nginx.conf.template \
    /etc/nginx/templates/default.conf.template

COPY docker/render/supervisord.conf \
    /etc/supervisor/conf.d/supervisord.conf

COPY docker/render/entrypoint.sh \
    /usr/local/bin/render-entrypoint

RUN chmod +x /usr/local/bin/render-entrypoint

EXPOSE 10000

ENTRYPOINT ["/usr/local/bin/render-entrypoint"]
